* text=auto

# scripts that must keep LF in the working tree
*.sh text eol=lf

# Windows-native files
*.bat text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf

# binaries
*.ico binary
*.png binary
*.jpg binary
*.wav binary
*.gif binary
*.mp4 binary
*.pdf binary
*.epub binary

# copyleft texts: byte-exact, LF, never normalised away
# every file in licenses/ is a legal artefact: byte-exact and LF on every OS,
# because a Windows checkout with core.autocrlf=true would otherwise rewrite them
licenses/* text eol=lf
